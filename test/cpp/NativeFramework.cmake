# Native integration tests; use the same shared libraries as Python/CLI.
function(dnds_add_native_test GROUP NAME SOURCE USE_MPI)
    set(TARGET_NAME "${GROUP}_test_${NAME}")
    add_executable(${TARGET_NAME} EXCLUDE_FROM_ALL ${SOURCE})
    target_include_directories(${TARGET_NAME} PRIVATE ${DNDS_EXTERNAL_INCLUDE_DOCTEST} ${DNDS_EXTERNAL_INCLUDES} ${DNDS_INCLUDES})
    target_link_libraries(${TARGET_NAME} PRIVATE cauchy_shared physics_shared native_cfv_shared native_geom_shared dnds_shared ${DNDS_EXTERNAL_LIBS})
    target_compile_definitions(${TARGET_NAME} PRIVATE DNDS_TEST_SOURCE_ROOT="${PROJECT_SOURCE_DIR}")
    if(DNDS_USE_CCACHE)
        set_property(TARGET ${TARGET_NAME} PROPERTY CXX_COMPILER_LAUNCHER ${DNDS_CCACHE_EXEC})
    endif()
    if(USE_MPI)
        foreach(NP ${DNDS_TEST_NP_LIST})
            set(TEST_NAME "${GROUP}_${NAME}_np${NP}")
            add_test(NAME ${TEST_NAME} COMMAND ${MPIEXEC_EXECUTABLE} ${MPIEXEC_NUMPROC_FLAG} ${NP} ${MPIEXEC_PREFLAGS} $<TARGET_FILE:${TARGET_NAME}> ${MPIEXEC_POSTFLAGS})
            set_tests_properties(${TEST_NAME} PROPERTIES PROCESSORS ${NP} TIMEOUT 300 LABELS "native;${GROUP}" ENVIRONMENT "OMP_NUM_THREADS=${DNDS_TEST_OMP_THREADS};HWLOC_COMPONENTS=-gl")
        endforeach()
    else()
        add_test(NAME "${GROUP}_${NAME}" COMMAND ${TARGET_NAME})
        set_tests_properties("${GROUP}_${NAME}" PROPERTIES TIMEOUT 300 LABELS "native;${GROUP}" ENVIRONMENT "OMP_NUM_THREADS=${DNDS_TEST_OMP_THREADS};HWLOC_COMPONENTS=-gl")
    endif()
    add_dependencies(${GROUP}_unit_tests ${TARGET_NAME})
endfunction()

foreach(GROUP native_geom native_cfv physics cauchy)
    add_custom_target(${GROUP}_unit_tests)
    add_dependencies(all_unit_tests ${GROUP}_unit_tests)
endforeach()

if(DNDS_USE_CUDA AND DNDS_BUILD_CAUCHY_CUDA_TESTS)
    add_custom_target(cauchy_cuda_tests)
    foreach(PAIR
            "point_physics;PointPhysics_CUDA" "auxiliary;AuxiliaryCUDA"
            "rhs;RHSCUDA" "source;SourceCUDA" "positivity;PositivityCUDA"
            "gradient;GradientCUDA" "limited_vr;LimitedVRCUDA"
            "characteristics;CharacteristicsCUDA" "state;StateCUDA")
        list(GET PAIR 0 TEST_NAME)
        list(GET PAIR 1 SOURCE_NAME)
        dnds_add_native_test(cauchy "${TEST_NAME}_cuda" "Cauchy/test_${SOURCE_NAME}.cu" OFF)
        set_property(TARGET cauchy_test_${TEST_NAME}_cuda APPEND PROPERTY BUILD_RPATH "$<TARGET_FILE_DIR:CUDA::cudart>")
        set_tests_properties(cauchy_${TEST_NAME}_cuda PROPERTIES RESOURCE_LOCK gpu LABELS "native;cauchy;cuda")
        add_dependencies(cauchy_cuda_tests cauchy_test_${TEST_NAME}_cuda)
    endforeach()
endif()
