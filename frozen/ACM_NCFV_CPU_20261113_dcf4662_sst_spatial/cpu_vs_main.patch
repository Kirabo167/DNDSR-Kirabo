+    template <int gDim>
+    void ACMTurbulenceTransport<gDim>::BoundSSTDiffusionGradient(index left, index right,
+        const Vector3 &normal, TurbulenceGradient &gradient) const
+    {
+        if (_turbulenceSettings.model != TurbulenceModel::KOmegaSST) return;
