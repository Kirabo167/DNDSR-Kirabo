{
    "solver": {
        "type": "ncfv_euler",
        "discretization": "NCFV",
        "model": "IdealGas",
        "fieldNVariables": 4
    },
    "$schema": "ncfv_euler2D_schema.json",
    "dimension": 2,
    "mesh": {
        "meshFile": "../data/mesh/CylinderA1.cgns",
        "reorderCells": 0,
        "periodicTolerance": 1e-09,
        "partitionOptions": {
            "metisType": "KWAY",
            "metisUfactor": 20,
            "metisSeed": 0,
            "edgeWeightMethod": 0,
            "metisNcuts": 3
        }
    },
    "algorithm": {
        "mode": "EfficientDifferential",
        "quadratureOrder": 4,
        "retainMicroGeometry": true,
        "checkGeometryClosure": true,
        "closureTolerance": 2e-10
    },
    "reconstruction": {
        "method": "SVDLeastSquares",
        "stencilSizeFactor": 1.7,
        "maximumStencilRings": 4,
        "distanceWeightPower": 1.0,
        "distanceWeightFloor": 0.15,
        "svdTolerance": 1e-11,
        "maximumConditionNumber": 1e12,
        "variationalIterations": 30,
        "variationalRelaxation": 1.0,
        "variationalWeight": 1.0,
        "enableLimiter": true
    },
    "physics": {
        "gamma": 1.4,
        "riemannSolver": "Roe",
        "boundaryMode": "FarField",
        "initialPrimitive": [1.0, 0.1, 0.0, 1.0],
        "farFieldPrimitive": [1.0, 0.1, 0.0, 1.0]
    },
    "time": {
        "iterations": 0,
        "timeStep": 0.0001,
        "reportInterval": 10
    }
}
