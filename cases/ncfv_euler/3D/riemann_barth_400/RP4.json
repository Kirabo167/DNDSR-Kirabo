{
    "$schema": "../ncfv_euler3D_schema.json",
    "solver": {
        "type": "ncfv_euler",
        "discretization": "NCFV",
        "model": "IdealGas",
        "fieldNVariables": 5
    },
    "dimension": 3,
    "mesh": {
        "meshFile": "../data/mesh/riemann_barth_400x400x10.cgns"
    },
    "algorithm": {
        "mode": "EfficientDifferential",
        "quadratureOrder": 4,
        "surfaceQuadratureOrder": 3,
        "retainMicroGeometry": false
    },
    "reconstruction": {
        "method": "SVDLeastSquares",
        "stencilSizeFactor": 1.7,
        "maximumStencilRings": 4,
        "enableLimiter": true
    },
    "physics": {
        "gamma": 1.4,
        "riemannSolver": "Roe",
        "boundaryMode": "SupersonicOutlet",
        "initialPrimitive": [0.5313, 0.1, 0.1, 0, 0.4],
        "farFieldPrimitive": [0.5313, 0.1, 0.1, 0, 0.4],
        "requireBoundaryZoneCoverage": true,
        "boundaryZones": [
            {"name": "XMIN", "mode": "SupersonicOutlet"},
            {"name": "XMAX", "mode": "SupersonicOutlet"},
            {"name": "YMIN", "mode": "SupersonicOutlet"},
            {"name": "YMAX", "mode": "SupersonicOutlet"},
            {"name": "ZMIN", "mode": "SlipWall"},
            {"name": "ZMAX", "mode": "SlipWall"}
        ],
        "viscous": {"enabled": false}
    },
    "initialField": {
        "nodeFile": "../data/mesh/riemann_barth_400_initial/RP4.csv",
        "nodeFileVariables": "Conservative",
        "nodeFileIndexBase": 0,
        "requireCompleteNodeFile": true,
        "expressions": [
            {
                "program": [
                    "inRegion := 1;",
                    "UPrim[0] := if(x[1] < 0.5, if(x[0] < 0.5, 0.8, 1), if(x[0] < 0.5, 1.0222, 0.5313));",
                    "UPrim[1] := if((x[0] < 0.5) and (x[1] >= 0.5), -0.6179, 0.1);",
                    "UPrim[2] := if((x[0] >= 0.5) and (x[1] < 0.5), 0.8276, 0.1);",
                    "UPrim[3] := 0;",
                    "UPrim[4] := if((x[0] >= 0.5) and (x[1] >= 0.5), 0.4, 1);",
                    "0;"
                ]
            }
        ]
    },
    "time": {
        "iterations": 1000000,
        "endTime": 0.2,
        "useCFLTimeStep": true,
        "useLocalTimeStep": false,
        "cfl": 0.5,
        "minimumTimeStep": 1e-12,
        "maximumTimeStep": 0.0001,
        "reportInterval": 10
    },
    "io": {
        "writeVTK": true,
        "writeInitial": true,
        "writeFinal": true,
        "outputInterval": 30,
        "outputPrefix": "../data/out/NCFV/riemann_barth_400/RP4/solution",
        "vtkSeriesName": "../data/out/NCFV/riemann_barth_400/RP4/series",
        "vtkFloatEncoding": "binary",
        "restartInterval": 500,
        "writeFinalRestart": true,
        "restartPrefix": "../data/out/NCFV/riemann_barth_400/RP4/restart",
        "restartSerializer": {"type": "H5"},
        "writeResolvedConfiguration": true
    }
}
