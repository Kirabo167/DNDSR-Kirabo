{
    "$schema": "../ncfv_euler3D_schema.json",
    "solver": {
        "type": "ncfv_euler",
        "discretization": "NCFV",
        "model": "IdealGas",
        "fieldNVariables": 5
    },
    "dimension": 3,
    "mesh": {
        "meshFile": "grid.cgns",
        "periodicLengths": [0, 0, 0.00125],
        "periodicBoundaryPairs": ["ZMIN", "ZMAX"]
    },
    "algorithm": {
        "mode": "EfficientDifferential",
        "quadratureOrder": 4,
        "surfaceQuadratureOrder": 3,
        "retainMicroGeometry": false
    },
    "reconstruction": {
        "stencilSelectionStrategy": "Original",
        "method": "SVDLeastSquares",
        "stencilSizeFactor": 1.7,
        "maximumStencilRings": 4,
        "completeStencilRings": true,
        "enableLimiter": true,
        "limitPointRecovery": false,
        "barthZeroOrderFallback": false,
        "sharedGradientFaceSweep": false,
        "sharedGradientFaceSweepParallel": false,
        "sharedGradientBudget": false,
        "limitPressure": false,
        "directionalPairBounds": false,
        "limitFluxCorrection": true,
        "fluxCorrectionBinary": false,
        "fluxCorrectionEntropy": true,
        "fluxCorrectionPairBounds": false,
        "maximumFluxCorrection": 1.0
    },
    "physics": {
        "gamma": 1.4,
        "riemannSolver": "Roe",
        "boundaryMode": "SupersonicOutlet",
        "initialPrimitive": [1.5, 0, 0, 0, 1.5],
        "farFieldPrimitive": [1.5, 0, 0, 0, 1.5],
        "requireBoundaryZoneCoverage": true,
        "boundaryZones": [
            {"name": "XMIN", "mode": "SupersonicOutlet"},
            {"name": "XMAX", "mode": "SupersonicOutlet"},
            {"name": "YMIN", "mode": "SupersonicOutlet"},
            {"name": "YMAX", "mode": "SupersonicOutlet"},
            {"name": "ZMIN", "mode": "Periodic"},
            {"name": "ZMAX", "mode": "Periodic"}
        ],
        "viscous": {"enabled": false}
    },
    "initialField": {
        "nodeFile": "RP1.csv",
        "nodeFileVariables": "Conservative",
        "nodeFileIndexBase": 0,
        "requireCompleteNodeFile": true
    },
    "time": {
        "iterations": 1000000,
        "endTime": 0.3,
        "useCFLTimeStep": true,
        "useLocalTimeStep": false,
        "cfl": 0.4,
        "minimumTimeStep": 1e-12,
        "maximumTimeStep": 0.001,
        "reportInterval": 10,
        "rejectNonPhysicalSteps": true,
        "maximumStepRetries": 20
    },
    "io": {
        "writeVTK": false,
        "writeInitial": false,
        "writeFinal": false,
        "outputInterval": 1000000,
        "outputPrefix": "solution",
        "vtkSeriesName": "series",
        "vtkFloatEncoding": "binary",
        "restartInput": "",
        "restartInterval": 500,
        "writeFinalRestart": true,
        "restartPrefix": "restart",
        "restartSerializer": {"type": "H5"},
        "writeResolvedConfiguration": true
    }
}
