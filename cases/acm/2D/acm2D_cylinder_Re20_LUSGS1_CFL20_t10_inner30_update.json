// File: cases/acm/2D/acm2D_cylinder_Re20_LUSGS1_CFL20_t10_inner30_update.json
// Purpose: Re_D=20 cylinder convergence test with exactly one LU-SGS sweep per pseudo-time correction.
// Mesh: existing 2048-cell diagnostic O-grid; center (0,0), diameter D=1, outer radius=20.
// Nondimensional flow: rho=1, U_inf=1, D=1, so mu=rho*U_inf*D/Re_D=0.05.
// Time integration: backward-Euler startup followed by BDF2 dual-time standalone LU-SGS.
// Budget-limited diagnostic: 1000 physical steps with dt=0.01, reaching t*=10.
// User setting: at most 30 pseudo-time corrections per physical step, CFL=20.
// Nonconverged steps are advanced explicitly for this fixed-budget experiment and logged as converged=0.
// Reference-style early exit: applied-update L2 / updated-state L2 < 1e-5, after at least 2 corrections.
// Also report true BDF RMS and its absolute 1e-8 OR physical-step relative 1e-4 diagnostic.
// Each nonlinear correction uses at most one full forward/backward SGS sweep, followed by damping 0.7.
// Intended launch from build/ with 2 MPI ranks and OMP_NUM_THREADS=1:
// mpirun -np 2 ./app/acm2D.exe ../cases/acm/2D/acm2D_cylinder_Re20_LUSGS1_CFL20_t10_inner30_update.json
// This diagnostic mesh and run duration do not establish grid independence or a developed wake.
{
    "solver": {
        "type": "ACM",
        "discretization": "CFV",
        "model": "ConstantDensity2D",
        "fieldNVariables": 4
    },
    "$schema": "acm2D_schema.json",
    // Constant-density artificial-compressibility state [u,v,w,p].
    "acmSettings": {
        "rho0": 1.0,
        "beta2": 4.0,
        "alpha": 0.5,
        "dynamicViscosity": 0.05,
        "riemannSolverType": "Roe",
        "pressureStorage": "PhysicalP",
        "entropyFixRatio": 0.05,
        "pressureReference": 0.0,
        "farFieldValue": [1.0, 0.0, 0.0, 0.0],
        "enableViscousFlux": true
    },

    "timeMarchSettings": {
        "integrator": "BDF2DualTimeLUSGS",
        "nSteps": 1000,
        // Inactive fallback because CFL-based local pseudo-time stepping is enabled.
        "pseudoTimeStep": 0.0005,
        "physicalTimeStep": 0.01,
        "useCFLTimeStep": true,
        "useLocalTimeStep": true,
        "cfl": 20.0,
        "maximumPseudoTimeStep": 1e100,
        // Requested physical-step correction budget.
        "maxImplicitIterations": 30,
        "implicitTolerance": 1e-8,
        "dualTimeConvergenceCriterion": "RelativeUpdate",
        "dualTimeUpdateRelativeTolerance": 1e-5,
        "dualTimeUpdateMinimumIterations": 2,
        "dualTimeFlowRelativeTolerance": 1e-4,
        "dualTimeTurbulenceRelativeTolerance": 0.0,
        "dualTimeRequireConvergence": false,
        "implicitRelaxation": 0.7,
        "lusgsSweeps": 1,
        // GMRES controls are inactive for standalone LU-SGS.
        "gmresSubspace": 20,
        "gmresRestarts": 3,
        "linearRelativeTolerance": 1e-6,
        "linearAbsoluteTolerance": 1e-10,
        "gmresPreconditioner": "LUSGS"
    },

    // Laminar flow; the remaining turbulence values are inactive but required.
    "turbulenceSettings": {
        "model": "Laminar",
        "initialValue": [1e-6, 1.0],
        "farFieldValue": [1e-6, 1.0],
        "minimumValue": [1e-12, 1e-10],
        "maximumValue": [1000000.0, 1000000000000.0],
        "maximumEddyViscosityRatio": 100000.0,
        "wallOmegaCoefficient": 800.0,
        "enableSourceTerms": true,
        "secondOrderReconstruction": true,
        "transportSubsteps": 4,
        "transportTimeScale": 0.25,
        "wallDistanceMethod": 1,
        "wallDistanceExecution": 0,
        "wallDistanceSubdivide": 0,
        "minimumWallDistance": 1e-10,
        "wallDistanceVerbose": 0
    },

    "meshSettings": {
        "meshFile": "../data/acm_cylinder_inner_diagnostic/mesh/cylinder_2048_mild.cgns",
        "meshElevation": 0,
        "meshDirectBisect": 0,
        "meshReorderCells": 0,
        "periodicTolerance": 1e-9,
        "periodicTranslation1": [0.0, 0.0, 0.0],
        "periodicTranslation2": [0.0, 0.0, 0.0],
        "periodicTranslation3": [0.0, 0.0, 0.0],
        "partitionOptions": {
            "metisType": "KWAY",
            "metisUfactor": 20,
            "metisSeed": 0,
            "edgeWeightMethod": 0,
            "metisNcuts": 3
        }
    },

    "reconstructionSettings": {
        "type": "Variational",
        "variationalIterations": 3,
        "resetVariationalCoefficients": false,
        "enableLimiter": true,
        "limiterType": "CWBAP"
    },

    "outputSettings": {
        "interval": 10,
        "directory": "../data/outACM/acm2D_CylinderRe20_LUSGS1_CFL20_t10_inner30_update",
        "prefix": "Cylinder2048_Re20_LUSGS1_CFL20_t10_inner30_update",
        "writeInitial": true
    },

    "vfvSettings": {
        "maxOrder": 2,
        "intOrder": 4,
        "ignoreMeshGeometryDeficiency": false,
        "nIterCellSmoothScale": 15,
        "intOrderVR": -1,
        "intOrderVRBC": -2,
        "cacheDiffBase": true,
        "cacheDiffBaseSize": 6,
        "jacobiRelax": 1.0,
        "SORInstead": true,
        "smoothThreshold": 0.01,
        "WBAP_nStd": 10.0,
        "normWBAP": false,
        "limiterBiwayAlter": 0,
        "subs2ndOrder": 0,
        "subs2ndOrderGGScheme": 1,
        "svdTolerance": 0.0,
        "baseSettings": {
            "localOrientation": false,
            "anisotropicLengths": false
        },
        "functionalSettings": {
            "scaleType": "BaryDiff",
            "scaleMultiplier": 1.0,
            "dirWeightScheme": "Factorial",
            "dirWeightCombPowV": 1,
            "manualDirWeights": [1.0, 1.0, 0.5, 0.16666666666666666, 0.041666666666666664],
            "geomWeightScheme": "GWNone",
            "geomWeightPower": 0.5,
            "geomWeightPower1": 0.0,
            "geomWeightPower2": 0.0,
            "useAnisotropicFunctional": false,
            "tanWeightScale": 1.0,
            "anisotropicType": "InertiaCoord",
            "inertiaWeightPower": 1.0,
            "geomWeightBias": 0.0,
            "greenGauss1Weight": 0.0,
            "greenGauss1Bias": 0.5,
            "greenGauss1Penalty": 0.0,
            "greenGaussSpacial": 0
        },
        "bcWeight": 1.0
    },

    "defaultBoundaryType": "BCFar",
    "boundaryConditions": [
        {
            "type": "BCWall",
            "name": "WALL",
            "value": [0.0, 0.0, 0.0, 0.0],
            "frameOption": 0,
            "anchorOption": 0,
            "integrationOption": 0,
            "specialOption": 0,
            "rectifyOption": 0,
            "valueExtra": []
        },
        {
            "type": "BCFar",
            "name": "FAR",
            "value": [1.0, 0.0, 0.0, 0.0],
            "frameOption": 0,
            "anchorOption": 0,
            "integrationOption": 0,
            "specialOption": 0,
            "rectifyOption": 0,
            "valueExtra": []
        }
    ],

    // Match the previous initial state, including the small transverse perturbation.
    "initialState": [1.0, 0.001, 0.0, 0.0],
    "boundaryValue": [1.0, 0.0, 0.0, 0.0],
    "leftState": [1.0, 0.0, 0.0, 0.0],
    "rightState": [0.0, 0.0, 0.0, 0.0],
    "unitNormal": [1.0, 0.0, 0.0],
    "nFacesPerRank": 16
}
