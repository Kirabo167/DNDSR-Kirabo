{
    "solver": {
        "type": "ACM",
        "discretization": "CFV",
        "model": "ConstantDensity2EQ2D",
        "fieldNVariables": 6
    },
    "$schema": "acm2EQ2D_schema.json",
    "acmSettings": {
        "rho0": 1,
        "beta2": 4.0,
        "alpha": 0.5,
        "dynamicViscosity": 0.001,
        "riemannSolverType": "Roe",
        "pressureStorage": "PhysicalP",
        "entropyFixRatio": 0.05,
        "pressureReference": 0.0,
        "farFieldValue": [
            1.0,
            0.0,
            0.0,
            0.0
        ],
        "enableViscousFlux": true
    },
    "timeMarchSettings": {
        "integrator": "ImplicitEulerLUSGS",
        "nSteps": 3,
        "pseudoTimeStep": 0.001,
        "useCFLTimeStep": false,
        "useLocalTimeStep": true,
        "cfl": 2.0,
        "maximumPseudoTimeStep": 0.05,
        "maxImplicitIterations": 200,
        "implicitTolerance": 1e-8,
        "steadyRelativeTolerance": 1e-4,
        "implicitRelaxation": 0.8,
        "lusgsSweeps": 2,
        "gmresSubspace": 20,
        "gmresRestarts": 2,
        "linearRelativeTolerance": 1e-6,
        "linearAbsoluteTolerance": 1e-10,
        "gmresPreconditioner": "LUSGS"
    },
    "turbulenceSettings": {
        "model": "KOmegaWilcox",
        "initialValue": [
            0.001,
            1
        ],
        "farFieldValue": [
            0.001,
            1
        ],
        "minimumValue": [
            1e-12,
            1e-10
        ],
        "maximumValue": [
            1000000.0,
            1000000000000.0
        ],
        "maximumEddyViscosityRatio": 100000.0,
        "wallOmegaCoefficient": 800.0,
        "enableSourceTerms": true,
        "secondOrderReconstruction": true,
        "transportSubsteps": 1,
        "transportTimeScale": 1,
        "wallDistanceMethod": 1,
        "wallDistanceExecution": 0,
        "wallDistanceSubdivide": 0,
        "minimumWallDistance": 1e-10,
        "wallDistanceVerbose": 0
    },
    "meshSettings": {
        "meshFile": "../data/mesh/ACMVariable_verify2D.cgns",
        "meshElevation": 0,
        "meshDirectBisect": 0,
        "meshReorderCells": 0,
        "periodicTolerance": 1e-09,
        "periodicTranslation1": [
            0,
            0,
            0
        ],
        "periodicTranslation2": [
            0,
            0,
            0
        ],
        "periodicTranslation3": [
            0,
            0,
            0
        ],
        "partitionOptions": {
            "metisType": "KWAY",
            "metisUfactor": 20,
            "metisSeed": 0,
            "edgeWeightMethod": 0,
            "metisNcuts": 3
        }
    },
    "reconstructionSettings": {
        "type": "Variational",
        "variationalIterations": 3,
        "resetVariationalCoefficients": false,
        "enableLimiter": true,
        "limiterType": "CWBAP"
    },
    "outputSettings": {
        "interval": 0,
        "directory": "../data/outACM/acm2D",
        "prefix": "acm2EQ2D",
        "writeInitial": true
    },
    "vfvSettings": {
        "maxOrder": 2,
        "intOrder": 4,
        "ignoreMeshGeometryDeficiency": false,
        "nIterCellSmoothScale": 15,
        "intOrderVR": -1,
        "intOrderVRBC": -2,
        "cacheDiffBase": false,
        "cacheDiffBaseSize": 3,
        "jacobiRelax": 1.0,
        "SORInstead": true,
        "smoothThreshold": 0.01,
        "WBAP_nStd": 10.0,
        "normWBAP": false,
        "limiterBiwayAlter": 0,
        "subs2ndOrder": 0,
        "subs2ndOrderGGScheme": 1,
        "svdTolerance": 0.0,
        "baseSettings": {
            "localOrientation": false,
            "anisotropicLengths": false
        },
        "functionalSettings": {
            "scaleType": "BaryDiff",
            "scaleMultiplier": 1.0,
            "dirWeightScheme": "Factorial",
            "dirWeightCombPowV": 1,
            "manualDirWeights": [
                1.0,
                1.0,
                0.5,
                0.16666666666666666,
                0.041666666666666664
            ],
            "geomWeightScheme": "GWNone",
            "geomWeightPower": 0.5,
            "geomWeightPower1": 0.0,
            "geomWeightPower2": 0.0,
            "useAnisotropicFunctional": false,
            "tanWeightScale": 1.0,
            "anisotropicType": "InertiaCoord",
            "inertiaWeightPower": 1.0,
            "geomWeightBias": 0.0,
            "greenGauss1Weight": 0.0,
            "greenGauss1Bias": 0.5,
            "greenGauss1Penalty": 0.0,
            "greenGaussSpacial": 0
        },
        "bcWeight": 1.0
    },
    "defaultBoundaryType": "BCFar",
    "boundaryConditions": [],
    "initialState": [
        1,
        0,
        0,
        0,
        0.001,
        1
    ],
    "boundaryValue": [
        1.0,
        0.0,
        0.0,
        0.0
    ],
    "leftState": [
        1.0,
        0.0,
        0.0,
        0.0
    ],
    "rightState": [
        0.0,
        0.0,
        0.0,
        0.0
    ],
    "unitNormal": [
        1.0,
        0.0,
        0.0
    ],
    "nFacesPerRank": 16,
    "caseNotes": {
        "purpose": "统一守恒状态的短步演示；不用于湍流模型精度验证。",
        "state": "[u,v,w,p,rho*k,rho*omega]"
    }
}
