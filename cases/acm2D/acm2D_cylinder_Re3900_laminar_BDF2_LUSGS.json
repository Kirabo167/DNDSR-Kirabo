// File: cases/acm2D/acm2D_cylinder_Re3900_laminar_BDF2_LUSGS.json
// Purpose: Two-dimensional unsteady cylinder-flow baseline at Re_D=3900.
// Mesh: data/mesh/CylinderA1.cgns; cylinder center (0,0), diameter D=1.
// Nondimensional flow: rho=1, U_inf=1, D=1, so mu=rho*U_inf*D/Re_D=1/3900.
// Time integration: backward-Euler startup followed by BDF2 dual-time LU-SGS.
// Run length: 10000 physical steps with dt=0.01, giving t*=t*U_inf/D=100.
// Output: initial field plus one field every 50 physical steps (201 fields in total).
// Intended launch from build/ with 32 MPI ranks:
// OMP_NUM_THREADS=1 mpirun -np 32 ./app/euler.exe \
//   ../cases/acm2D/acm2D_cylinder_Re3900_laminar_BDF2_LUSGS.json
// Important: real Re=3900 cylinder flow is three-dimensional and transitional. This two-dimensional
// laminar calculation is intended for algorithm verification and qualitative vortex visualization,
// not quantitative agreement with three-dimensional experimental statistics.
// Modifier: Runzhi Ma
{
    "solver": {
        "type": "ACM",
        "discretization": "CFV",
        "model": "ConstantDensity2D",
        "fieldNVariables": 4
    },
    // Constant-density artificial-compressibility state [u,v,w,p].
    "acmSettings": {
        "rho0": 1.0,
        "beta2": 4.0,
        "alpha": 0.5,
        // Re_D=rho0*U_inf*D/mu=3900 for rho0=U_inf=D=1.
        "dynamicViscosity": 0.0002564102564102564,
        "riemannSolverType": "Roe",
        "pressureStorage": "PhysicalP",
        "entropyFixRatio": 0.05,
        "pressureReference": 0.0,
        "farFieldValue": [1.0, 0.0, 0.0, 0.0],
        "enableViscousFlux": true
    },

    // Physical BDF2 outer steps with local-CFL pseudo-time iterations.
    "timeMarchSettings": {
        "integrator": "BDF2DualTimeLUSGS",
        "nSteps": 10000,
        // Fallback pseudo-time step when useCFLTimeStep=false.
        "pseudoTimeStep": 0.0005,
        // Uniform nondimensional physical time step; 10000 steps reach t*=100.
        "physicalTimeStep": 0.01,
        "useCFLTimeStep": true,
        "useLocalTimeStep": true,
        // Calibrated on the startup step. The 0.005 cap limits the effective local step;
        // CFL=20 with 15 iterations matched CFL=5 with 20 iterations at lower cost.
        "cfl": 20.0,
        "maximumPseudoTimeStep": 0.005,
        // Fixed upper limit for the dual-time iterations in every physical step.
        "maxImplicitIterations": 15,
        "implicitTolerance": 1e-8,
        "implicitRelaxation": 0.7,
        "lusgsSweeps": 2,
        // Required complete-config fields; inactive for BDF2DualTimeLUSGS.
        "gmresSubspace": 20,
        "gmresRestarts": 3,
        "gmresRelativeTolerance": 1e-4,
        "gmresPreconditioner": "LUSGS"
    },

    // BDF2 currently supports Laminar only. The remaining values are inactive but required.
    "turbulenceSettings": {
        "model": "Laminar",
        "initialValue": [1e-6, 1.0],
        "farFieldValue": [1e-6, 1.0],
        "minimumValue": [1e-12, 1e-10],
        "maximumValue": [1000000.0, 1000000000000.0],
        "maximumEddyViscosityRatio": 100000.0,
        "wallOmegaCoefficient": 800.0,
        "enableSourceTerms": true,
        "secondOrderReconstruction": true,
        "transportSubsteps": 4,
        "transportTimeScale": 0.25,
        "wallDistanceMethod": 1,
        "wallDistanceExecution": 0,
        "wallDistanceSubdivide": 0,
        "minimumWallDistance": 1e-10,
        "wallDistanceVerbose": 0
    },

    // Existing 2-D cylinder mesh: 23,791 cells and 80 cylinder-wall edges.
    "meshSettings": {
        "meshFile": "../data/mesh/CylinderA1.cgns",
        "meshElevation": 0,
        "meshDirectBisect": 0,
        "meshReorderCells": 0,
        "periodicTolerance": 1e-9,
        "periodicTranslation1": [0.0, 0.0, 0.0],
        "periodicTranslation2": [0.0, 0.0, 0.0],
        "periodicTranslation3": [0.0, 0.0, 0.0],
        "partitionOptions": {
            "metisType": "KWAY",
            "metisUfactor": 20,
            "metisSeed": 0,
            "edgeWeightMethod": 0,
            "metisNcuts": 3
        }
    },

    // Second-order variational reconstruction with startup limiting.
    "reconstructionSettings": {
        "type": "Variational",
        "variationalIterations": 3,
        "resetVariationalCoefficients": false,
        "enableLimiter": true,
        "limiterType": "CWBAP"
    },

    // Files are numbered 00000000, 00000050, ..., 00010000.
    "outputSettings": {
        "interval": 50,
        "directory": "../data/outACM/acm2D_CylinderRe3900_BDF2_LUSGS",
        "prefix": "CylinderA1_Re3900_laminar_BDF2_LUSGS",
        "writeInitial": true
    },

    "vfvSettings": {
        "maxOrder": 2,
        "intOrder": 4,
        "ignoreMeshGeometryDeficiency": false,
        "nIterCellSmoothScale": 15,
        "intOrderVR": -1,
        "intOrderVRBC": -2,
        "cacheDiffBase": false,
        "cacheDiffBaseSize": 3,
        "jacobiRelax": 1.0,
        "SORInstead": true,
        "smoothThreshold": 0.01,
        "WBAP_nStd": 10.0,
        "normWBAP": false,
        "limiterBiwayAlter": 0,
        "subs2ndOrder": 0,
        "subs2ndOrderGGScheme": 1,
        "svdTolerance": 0.0,
        "baseSettings": {
            "localOrientation": false,
            "anisotropicLengths": false
        },
        "functionalSettings": {
            "scaleType": "BaryDiff",
            "scaleMultiplier": 1.0,
            "dirWeightScheme": "Factorial",
            "dirWeightCombPowV": 1,
            "manualDirWeights": [1.0, 1.0, 0.5, 0.16666666666666666, 0.041666666666666664],
            "geomWeightScheme": "GWNone",
            "geomWeightPower": 0.5,
            "geomWeightPower1": 0.0,
            "geomWeightPower2": 0.0,
            "useAnisotropicFunctional": false,
            "tanWeightScale": 1.0,
            "anisotropicType": "InertiaCoord",
            "inertiaWeightPower": 1.0,
            "geomWeightBias": 0.0,
            "greenGauss1Weight": 0.0,
            "greenGauss1Bias": 0.5,
            "greenGauss1Penalty": 0.0,
            "greenGaussSpacial": 0
        },
        "bcWeight": 1.0
    },

    "defaultBoundaryType": "BCFar",
    "boundaryConditions": [
        {
            "type": "BCWall",
            "name": "WALL",
            "value": [0.0, 0.0, 0.0, 0.0],
            "frameOption": 0,
            "anchorOption": 0,
            "integrationOption": 0,
            "specialOption": 0,
            "rectifyOption": 0,
            "valueExtra": []
        },
        {
            "type": "BCFar",
            "name": "FAR",
            "value": [1.0, 0.0, 0.0, 0.0],
            "frameOption": 0,
            "anchorOption": 0,
            "integrationOption": 0,
            "specialOption": 0,
            "rectifyOption": 0,
            "valueExtra": []
        }
    ],

    // A small transverse perturbation breaks exact symmetry and triggers deterministic shedding.
    "initialState": [1.0, 0.001, 0.0, 0.0],
    "boundaryValue": [1.0, 0.0, 0.0, 0.0],
    "leftState": [1.0, 0.0, 0.0, 0.0],
    "rightState": [0.0, 0.0, 0.0, 0.0],
    "unitNormal": [1.0, 0.0, 0.0],
    // Compatibility-only preview size; MPI parallelism is selected by mpirun -np 32.
    "nFacesPerRank": 16
}
