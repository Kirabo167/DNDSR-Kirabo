// File: cases/acm2D/acm2D.json
// Purpose: Complete single-file configuration for steady laminar flow around a 2-D cylinder.
// Mesh: data/mesh/CylinderA1.cgns; cylinder center (0,0), diameter D=1.
// Domain: x approximately [-100,100], y approximately [-99.80005,100]. The refined wake block
//         covers x=[-2,30], y=[-2,2]. The mesh contains 23,791 cells, 80 WALL edges and 20 FAR edges.
// Nondimensional flow: rho=1, U_inf=1, p'=0, Re_D=20, hence mu=rho*U_inf*D/Re_D=0.05.
// Boundary model: WALL is stationary no-slip with zero normal pressure gradient; FAR is the
//                 general-alpha ACM characteristic far-field condition.
// Parallel launch from build/ with 32 MPI ranks:
// OMP_NUM_THREADS=1 mpirun -np 32 ./app/euler.exe ../cases/acm2D/acm2D.json
// Modifier: Runzhi Ma
{
    "solver": {
        "type": "ACM",
        "discretization": "CFV",
        "model": "ConstantDensity2D",
        "fieldNVariables": 4
    },
    // Constant-density artificial-compressibility flow model. State order is [u,v,w,p].
    "acmSettings": {
        "rho0": 1.0,
        // beta2/rho0 sets the squared artificial acoustic scale; sqrt(beta2/rho0)=2 here.
        "beta2": 4.0,
        // General Turkel preconditioning parameter; alpha=0.5 exercises the general eigen-system.
        "alpha": 0.5,
        // Re_D=rho0*U_inf*D/mu=20 for rho0=U_inf=D=1.
        "dynamicViscosity": 0.05,
        // Roe provides the general-alpha characteristic dissipation; entropy fix is 5%.
        "riemannSolverType": "Roe",
        "pressureStorage": "PhysicalP",
        "entropyFixRatio": 0.05,
        "pressureReference": 0.0,
        "farFieldValue": [1.0, 0.0, 0.0, 0.0],
        "enableViscousFlux": true
    },
    // Steady solution by local pseudo-time marching; this is not a physical-time integration.
    "timeMarchSettings": {
        // Backward Euler nonlinear updates, generic GMRES linear solve and ACM 4x4 LU-SGS preconditioner.
        "integrator": "ImplicitEulerGMRES",
        // Fixed maximum/actual outer-step count. The current driver logs residuals but does not stop early.
        "nSteps": 5000,
        // Fallback step used only when useCFLTimeStep=false.
        "pseudoTimeStep": 0.001,
        "useCFLTimeStep": true,
        // Every cell receives its own convective-viscous spectral-radius step.
        "useLocalTimeStep": true,
        // Conservative initial production setting for robust second-order convergence.
        "cfl": 2.0,
        "maximumPseudoTimeStep": 0.05,
        // At most five nonlinear backward-Euler corrections per outer pseudo-time step.
        "maxImplicitIterations": 5,
        "implicitTolerance": 1e-8,
        "implicitRelaxation": 0.8,
        // Two LU-SGS sweeps are used for every GMRES preconditioner application.
        "lusgsSweeps": 2,
        "gmresSubspace": 20,
        "gmresRestarts": 2,
        "gmresRelativeTolerance": 1e-4,
        "gmresPreconditioner": "LUSGS"
    },
    // Re_D=20 is laminar. This section remains present because one complete JSON must cover all modes;
    // its transported values are inactive while model=Laminar.
    "turbulenceSettings": {
        "model": "Laminar",
        "initialValue": [1e-6, 1.0],
        "farFieldValue": [1e-6, 1.0],
        "minimumValue": [1e-12, 1e-10],
        "maximumValue": [1000000.0, 1000000000000.0],
        "maximumEddyViscosityRatio": 100000.0,
        "wallOmegaCoefficient": 800.0,
        "enableSourceTerms": true,
        "secondOrderReconstruction": true,
        "transportSubsteps": 4,
        "transportTimeScale": 0.25,
        "wallDistanceMethod": 1,
        "wallDistanceExecution": 0,
        "wallDistanceSubdivide": 0,
        "minimumWallDistance": 1e-10,
        "wallDistanceVerbose": 0
    },
    // Mesh path is interpreted from the launch directory; the documented command runs from build/.
    "meshSettings": {
        "meshFile": "../data/mesh/CylinderA1.cgns",
        // CylinderA1 is already a first-order geometric mesh; no elevation or h-refinement is requested.
        "meshElevation": 0,
        "meshDirectBisect": 0,
        "meshReorderCells": 0,
        // No periodic boundaries exist in this case; the periodic entries are neutral defaults.
        "periodicTolerance": 1e-9,
        "periodicTranslation1": [0.0, 0.0, 0.0],
        "periodicTranslation2": [0.0, 0.0, 0.0],
        "periodicTranslation3": [0.0, 0.0, 0.0],
        "partitionOptions": {
            "metisType": "KWAY",
            "metisUfactor": 20,
            "metisSeed": 0,
            "edgeWeightMethod": 0,
            "metisNcuts": 3
        }
    },
    // High-order cell reconstruction: degree/order 2 variational polynomial with characteristic CWBAP.
    "reconstructionSettings": {
        "type": "Variational",
        "variationalIterations": 3,
        "resetVariationalCoefficients": false,
        "enableLimiter": true,
        "limiterType": "CWBAP"
    },
    // Store one parallel VTK-HDF flow field every 100 pseudo-time steps.
    "outputSettings": {
        "interval": 100,
        "directory": "../data/outACM/acm2D",
        "prefix": "acm2D_step",
        "writeInitial": true
    },
    // CFV quadrature and variational-reconstruction controls used by the preceding selection.
    "vfvSettings": {
        "maxOrder": 2,
        // Fourth-order face/cell integration avoids under-integration of the reconstructed polynomial.
        "intOrder": 4,
        "ignoreMeshGeometryDeficiency": false,
        "nIterCellSmoothScale": 15,
        "intOrderVR": -1,
        "intOrderVRBC": -2,
        "cacheDiffBase": false,
        "cacheDiffBaseSize": 3,
        "jacobiRelax": 1.0,
        "SORInstead": true,
        "smoothThreshold": 0.01,
        "WBAP_nStd": 10.0,
        "normWBAP": false,
        "limiterBiwayAlter": 0,
        "subs2ndOrder": 0,
        "subs2ndOrderGGScheme": 1,
        "svdTolerance": 0.0,
        "baseSettings": {
            "localOrientation": false,
            "anisotropicLengths": false
        },
        "functionalSettings": {
            "scaleType": "BaryDiff",
            "scaleMultiplier": 1.0,
            "dirWeightScheme": "Factorial",
            "dirWeightCombPowV": 1,
            "manualDirWeights": [1.0, 1.0, 0.5, 0.16666666666666666, 0.041666666666666664],
            "geomWeightScheme": "GWNone",
            "geomWeightPower": 0.5,
            "geomWeightPower1": 0.0,
            "geomWeightPower2": 0.0,
            "useAnisotropicFunctional": false,
            "tanWeightScale": 1.0,
            "anisotropicType": "InertiaCoord",
            "inertiaWeightPower": 1.0,
            "geomWeightBias": 0.0,
            "greenGauss1Weight": 0.0,
            "greenGauss1Bias": 0.5,
            "greenGauss1Penalty": 0.0,
            "greenGaussSpacial": 0
        },
        "bcWeight": 1.0
    },
    // Any unlisted external CGNS zone falls back to characteristic far field.
    "defaultBoundaryType": "BCFar",
    "boundaryConditions": [
        {
            // Stationary no-slip cylinder: face velocity is zero; pressure is extrapolated normally.
            "type": "BCWall",
            "name": "WALL",
            "value": [0.0, 0.0, 0.0, 0.0],
            "frameOption": 0,
            "anchorOption": 0,
            "integrationOption": 0,
            "specialOption": 0,
            "rectifyOption": 0,
            "valueExtra": []
        },
        {
            // Outer boundary near 100D: incoming modes take [1,0,0,0], outgoing modes extrapolate.
            "type": "BCFar",
            "name": "FAR",
            "value": [1.0, 0.0, 0.0, 0.0],
            "frameOption": 0,
            "anchorOption": 0,
            "integrationOption": 0,
            "specialOption": 0,
            "rectifyOption": 0,
            "valueExtra": []
        }
    ],
    // Uniform freestream initialization minimizes startup transients away from the cylinder.
    "initialState": [1.0, 0.0, 0.0, 0.0],
    "boundaryValue": [1.0, 0.0, 0.0, 0.0],
    // The following preview values are retained for configuration compatibility; the mesh solver uses
    // initialState and the named boundaryConditions above.
    "leftState": [1.0, 0.0, 0.0, 0.0],
    "rightState": [0.0, 0.0, 0.0, 0.0],
    "unitNormal": [1.0, 0.0, 0.0],
    "nFacesPerRank": 16
}
