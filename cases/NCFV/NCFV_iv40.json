{
    "solver": {
        "type": "Euler",
        "discretization": "NCFV",
        "model": "IdealGas",
        "fieldNVariables": 5
    },
    "dimension": 3,
    "mesh": {
        "meshFile": "../cases/NCFV/iv40_3d_1_dnds.cgns",
        "periodicTolerance": 1e-8,
        "periodicLengths": [10.0, 10.0, 4.0],
        "periodicBoundaryPairs": [
            "bc-2", "bc-2-1", "bc-3", "bc-3-1", "bc-4", "bc-4-1"
        ]
    },
    "algorithm": {
        "mode": "EfficientDifferential",
        "quadratureOrder": 4,
        "surfaceQuadratureOrder": 3,
        "retainMicroGeometry": false
    },
    "reconstruction": {
        "enableLimiter": false,
        "stencilSizeFactor": 1.7,
        "maximumStencilRings": 4
    },
    "physics": {
        "gamma": 1.4,
        "riemannSolver": "Roe",
        "initialPrimitive": [1.0, 1.0, 1.0, 0.0, 1.0],
        "farFieldPrimitive": [1.0, 1.0, 1.0, 0.0, 1.0],
        "requireBoundaryZoneCoverage": true,
        "boundaryZones": [
            {"name": "bc-2", "mode": "Periodic"},
            {"name": "bc-2-1", "mode": "Periodic"},
            {"name": "bc-3", "mode": "Periodic"},
            {"name": "bc-3-1", "mode": "Periodic"},
            {"name": "bc-4", "mode": "Periodic"},
            {"name": "bc-4-1", "mode": "Periodic"}
        ],
        "viscous": {"enabled": false}
    },
    "initialField": {
        "isentropicVortex": true,
        "vortexStrength": 5.0,
        "vortexCenter": [5.0, 5.0, 0.0]
    },
    "time": {
        "iterations": 10000,
        "endTime": 1.6,
        "timeStep": 0.05,
        "useCFLTimeStep": false,
        "useLocalTimeStep": false,
        "cfl": 0.5,
        "minimumTimeStep": 1e-30,
        "maximumTimeStep": 1e+30,
        "reportInterval": 20
    },
    "io": {
        "writeVTK": true,
        "writeInitial": true,
        "writeFinal": true,
        "outputInterval": 100,
        "outputPrefix": "../data/out/NCFV/iv40_efficient/solution",
        "vtkSeriesName": "../data/out/NCFV/iv40_efficient/series",
        "writeFinalRestart": true,
        "restartPrefix": "../data/out/NCFV/iv40_efficient/restart",
        "restartSerializer": {"type": "H5"}
    }
}
