{
    "solver": {
        "type": "Euler",
        "discretization": "NCFV",
        "model": "IdealGas",
        "fieldNVariables": 5
    },
    "dimension": 3,
    "mesh": {
        "meshFile": "../cases/NCFV/iv40_3d_1_dnds.cgns",
        "periodicTolerance": 1e-8,
        "periodicLengths": [
            10,
            10,
            4
        ],
        "periodicBoundaryPairs": [
            "bc-2", "bc-2-1", "bc-3", "bc-3-1", "bc-4", "bc-4-1"
        ]
    },
    "algorithm": {
        "mode": "EfficientDifferential",
        "quadratureOrder": 4,
        "retainMicroGeometry": false
    },
    "reconstruction": {
        "enableLimiter": false,
        "stencilSizeFactor": 1.7,
        "maximumStencilRings": 4
    },
    "physics": {
        "gamma": 1.4,
        "riemannSolver": "Roe",
        "initialPrimitive": [
            1,
            1,
            1,
            0,
            1
        ],
        "farFieldPrimitive": [
            1,
            1,
            1,
            0,
            1
        ],
        "requireBoundaryZoneCoverage": true,
        "boundaryZones": [
            {
                "name": "bc-2",
                "mode": "Periodic"
            },
            {
                "name": "bc-2-1",
                "mode": "Periodic"
            },
            {
                "name": "bc-3",
                "mode": "Periodic"
            },
            {
                "name": "bc-3-1",
                "mode": "Periodic"
            },
            {
                "name": "bc-4",
                "mode": "Periodic"
            },
            {
                "name": "bc-4-1",
                "mode": "Periodic"
            }
        ],
        "viscous": {
            "enabled": false
        }
    },
    "initialField": {
        "isentropicVortex": true,
        "vortexStrength": 5,
        "vortexCenter": [
            5,
            5,
            0
        ]
    },
    "time": {
        "iterations": 10000,
        "endTime": 2,
        "useCFLTimeStep": true,
        "useLocalTimeStep": false,
        "cfl": 0.25,
        "maximumTimeStep": 0.005,
        "reportInterval": 20
    },
    "io": {
        "writeVTK": true,
        "writeInitial": true,
        "writeFinal": true,
        "outputInterval": 100000,
        "outputPrefix": "../data/out/NCFV/convergence/iv40_halfdt/solution",
        "vtkSeriesName": "../data/out/NCFV/convergence/iv40_halfdt/series",
        "writeFinalRestart": true,
        "restartPrefix": "../data/out/NCFV/convergence/iv40_halfdt/restart",
        "restartSerializer": {
            "type": "H5"
        }
    }
}
