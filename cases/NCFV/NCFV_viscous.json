{
    "solver": {
        "type": "Euler",
        "discretization": "NCFV",
        "model": "IdealGas",
        "fieldNVariables": 5
    },
    "dimension": 2,
    "mesh": {"meshFile": "../data/mesh/CylinderA1.cgns", "ghostLayers": 2},
    "algorithm": {"mode": "EfficientDifferential", "retainMicroGeometry": false},
    "physics": {
        "initialPrimitive": [1.0, 0.1, 0.0, 1.0],
        "farFieldPrimitive": [1.0, 0.1, 0.0, 1.0],
        "requireBoundaryZoneCoverage": true,
        "boundaryZones": [
            {"name": "WALL", "mode": "NoSlipAdiabaticWall", "wallVelocity": [0.0, 0.0]},
            {"name": "FAR", "mode": "FarField", "primitive": [1.0, 0.1, 0.0, 1.0]}
        ],
        "viscous": {
            "enabled": true,
            "model": "Constant",
            "dynamicViscosity": 0.0001,
            "gasConstant": 1.0,
            "prandtlNumber": 0.72
        }
    },
    "time": {
        "iterations": 5,
        "useCFLTimeStep": true,
        "useLocalTimeStep": true,
        "cfl": 0.1,
        "reportInterval": 1
    },
    "io": {
        "writeVTK": true,
        "writeInitial": true,
        "writeFinal": true,
        "outputPrefix": "../data/out/NCFV/viscous/solution",
        "vtkSeriesName": "../data/out/NCFV/viscous/series",
        "writeFinalRestart": true,
        "restartPrefix": "../data/out/NCFV/viscous/restart"
    }
}
